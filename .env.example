# Copia este archivo a .env y completa los valores. .env NUNCA se sube a GitHub.

# OBLIGATORIA. Sal para enmascarar identificadores de personas naturales.
# 64 caracteres hexadecimales. Genérala con:  openssl rand -hex 32
# Debe ser la misma en todas las cargas (si cambia, cambian los identificadores NAT-…).
LUPA_HASH_SALT=

# Opcional: ruta del CLI de DuckDB 2.0.0 (por defecto "duckdb" en el PATH)
DUCKDB_BIN=

# Opcional: URL base de descarga del registro de Open Contracting Partnership
LUPA_SOURCE_URL=https://data.open-contracting.org/en/publication/110/download
